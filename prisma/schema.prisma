  branch                Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerId            String
  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId             String?
  service               Service?               @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  employeeId            String?
  employee              Employee?              @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  selectedHairstyleId   String?
  selectedHairstyle     Hairstyle?             @relation("SelectedHairstyle", fields: [selectedHairstyleId], references: [id], onDelete: SetNull)
  selectedHairColorId   String?
  selectedHairColor     HairColor?             @relation("SelectedHairColor", fields: [selectedHairColorId], references: [id], onDelete: SetNull)
  status                HairConsultationStatus @default(DRAFT)
  detectedFaceShape     FaceShape?
  faceShapeOverride     FaceShape?
  faceShapeConfidence   Float?
  faceAnalysisJson      Json?
  aiRecommendationsJson Json?
  notes                 String?                @db.Text
  servicePrice          Float?
  serviceDuration       Int?
  customerApproved      Boolean                @default(false)
  customerApprovedAt    DateTime?
  satisfactionRating    Int?
  wouldChooseAgain      Boolean?
  completedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  photos     HairConsultationPhoto[]
  selections HairConsultationSelection[]
  feedback   HairConsultationFeedback?

  @@index([salonId, customerId, createdAt])
  @@index([salonId, employeeId])
  @@index([salonId, status])
}

model HairConsultationPhoto {
  id              String                    @id @default(cuid())
  consultationId  String
  consultation    HairConsultation          @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  type            HairConsultationPhotoType
  storagePath     String
  thumbnailPath   String?
  mimeType        String                    @default("image/jpeg")
  width           Int?
  height          Int?
  metadata        Json?
  createdAt       DateTime                  @default(now())

  previewSelections HairConsultationSelection[]

  @@index([consultationId, type])
}

model HairConsultationSelection {
  id              String           @id @default(cuid())
  consultationId  String
  consultation    HairConsultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  hairstyleId     String
  hairstyle       Hairstyle        @relation(fields: [hairstyleId], references: [id], onDelete: Restrict)
  hairColorId     String?
  hairColor       HairColor?       @relation(fields: [hairColorId], references: [id], onDelete: SetNull)
  previewPhotoId  String?
  previewPhoto    HairConsultationPhoto? @relation(fields: [previewPhotoId], references: [id], onDelete: SetNull)
  matchScore      Float?
  isCustomerChoice Boolean         @default(false)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())

  @@index([consultationId])
}

model HairConsultationFeedback {
  id              String           @id @default(cuid())
  consultationId  String           @unique
  consultation    HairConsultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  rating          Int
  wouldChooseAgain Boolean
  comment         String?          @db.Text
  createdAt       DateTime         @default(now())
}
