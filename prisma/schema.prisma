generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SalonPlan {
  BASIC
  ENTERPRISE
}

enum PlatformRole {
  SUPER_ADMIN
  CUSTOMER_SUPPORT
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Salon {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  plan                SalonPlan @default(ENTERPRISE)
  phone               String?
  address             String?
  businessType        String?
  gstin               String?
  gstEnabled          Boolean  @default(true)
  addressLine1        String?
  city                String?
  state               String?
  pincode             String?
  businessPhone       String?
  businessEmail       String?
  openingHours        String?
  currency            String   @default("INR")
  expectedTeamSize    Int?
  onboardingCompleted Boolean  @default(true)
  logoUrl             String?
  totalSeats          Int      @default(4)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users        User[]
  employees    Employee[]
  seats        Seat[]
  services     Service[]
  customers    Customer[]
  queueEntries QueueEntry[]
  appointments Appointment[]
  invoices     Invoice[]
  smsReminders SmsReminder[]
  serviceCategories ServiceCategory[]
  stockCategories   StockCategory[]
  stockItems   StockItem[]
  stockPurchases StockPurchase[]
  suppliers    Supplier[]
  productBrands  ProductBrand[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  stockAdjustments StockAdjustment[]
  staffProductIssues StaffProductIssue[]
  serviceRecipes ServiceRecipe[]
  stockLedgerEntries StockLedgerEntry[]
  branches       Branch[]
  branchTransfers BranchTransfer[]
  customSegments CustomSegment[]
  shifts         Shift[]
  timesheets     Timesheet[]
  payRuns        PayRun[]
  faceProfiles   EmployeeFaceProfile[]
  attendanceRecords AttendanceRecord[]
  reportFavorites ReportFavorite[]
  subscription    SalonSubscription?
  platformInvoices PlatformInvoice[]
  passwordResetTokens PasswordResetToken[]
  adminImpersonationTokens AdminImpersonationToken[]
  projects         Project[]
  supportConversation SupportConversation?
  membershipPlans       MembershipPlan[]
  membershipBenefits    MembershipBenefit[]
  customerMemberships   CustomerMembership[]
  membershipTransactions MembershipTransaction[]
  loyaltySettings       LoyaltySettings?
  loyaltyPointsLedger   LoyaltyPointsLedger[]
  walletAccounts        WalletAccount[]
  walletTransactions    WalletTransaction[]
  membershipOffers      MembershipOffer[]
  giftCards             GiftCard[]
  familyMembershipMembers FamilyMembershipMember[]
  membershipUsageLogs   MembershipUsageLog[]
  membershipSettings    MembershipSettings?
  whatsappSettings      WhatsAppSettings?
  hairConsultations     HairConsultation[]
  hairstyleCategories   HairstyleCategory[]
  hairstyles            Hairstyle[]
  hairColors            HairColor[]
  hairConsultationSettings HairConsultationSettings?
  salonRoles           SalonRole[]
  serviceMenuImports   ServiceMenuImport[]
}

enum SupportMessageSender {
  SALON
  ADMIN
}

enum SupportConversationStatus {
  OPEN
  WAITING
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
}

model SupportConversation {
  id              String                    @id @default(cuid())
  salonId         String                    @unique
  salon           Salon                     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  ticketNumber    String?                   @unique
  subject         String?
  status          SupportConversationStatus @default(OPEN)
  priority        SupportTicketPriority     @default(MEDIUM)
  metadata        Json?
  lastMessageAt   DateTime                  @default(now())
  adminLastReadAt DateTime?
  salonLastReadAt DateTime?
  agentJoinedAt   DateTime?
  statusChangedAt DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  messages        SupportMessage[]

  @@index([lastMessageAt])
  @@index([status, lastMessageAt])
}

model SupportMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   SupportConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     SupportMessageSender
  senderUserId   String
  senderName     String
  body           String
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
}

model AdminImpersonationToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  salonId     String
  salon       Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  ownerUserId String
  adminUserId String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([salonId])
  @@index([adminUserId])
}

model PlatformAdminAuditLog {
  id           String   @id @default(cuid())
  action       String
  adminUserId  String
  salonId      String?
  targetUserId String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([adminUserId])
  @@index([salonId])
  @@index([createdAt])
}

model SalonSubscription {
  id                 String   @id @default(cuid())
  salonId            String   @unique
  salon              Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  status             String   @default("trial")
  planName           String   @default("Enterprise")
  monthlyAmount      Float    @default(1999)
  setupFeePaid       Boolean  @default(false)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PlatformInvoice {
  id            String    @id @default(cuid())
  salonId       String
  salon         Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  invoiceNumber String
  amount        Float
  tax           Float     @default(0)
  total         Float
  periodStart   DateTime
  periodEnd     DateTime
  dueDate       DateTime
  paidAt        DateTime?
  status        String    @default("draft")
  paymentMethod String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([salonId, invoiceNumber])
  @@index([salonId, status])
}

model ReportFavorite {
  id         String   @id @default(cuid())
  salonId    String
  salon      Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  userId     String
  reportSlug String
  createdAt  DateTime @default(now())

  @@unique([salonId, userId, reportSlug])
  @@index([salonId, userId])
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  password      String
  name          String
  phone         String?
  role          String        @default("owner")
  isSuperAdmin  Boolean       @default(false)
  platformRole  PlatformRole?
  isActive      Boolean       @default(true)
  salonId       String?
  salon         Salon?        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  salonRoleId   String?
  salonRole     SalonRole?    @relation(fields: [salonRoleId], references: [id], onDelete: SetNull)
  employeeId    String?       @unique
  employee      Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  passwordResetTokens PasswordResetToken[]
  permissionOverrides UserPermissionOverride[]
  serviceMenuImports ServiceMenuImport[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([salonId])
  @@index([salonRoleId])
}

/// Global permission catalog (same keys for every salon).
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  module      String
  action      String
  createdAt   DateTime @default(now())

  rolePermissions SalonRolePermission[]
  userOverrides   UserPermissionOverride[]
}

/// Tenant-scoped role (system or custom).
model SalonRole {
  id             String   @id @default(cuid())
  salonId        String
  salon          Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  key            String
  name           String
  description    String?
  hierarchyLevel Int
  isSystemRole   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  permissions SalonRolePermission[]
  users       User[]

  @@unique([salonId, key])
  @@index([salonId])
}

model SalonRolePermission {
  roleId       String
  permissionId String
  role         SalonRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// Per-user grant/deny override (deny wins over role defaults).
model UserPermissionOverride {
  userId       String
  permissionId String
  granted      Boolean
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  salonId   String
  salon     Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([salonId])
}

model Employee {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  email       String?
  role        String
  specialties String?
  avatarUrl   String?
  status      String   @default("active")
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  pincode           String?
  country           String?  @default("India")
  aadharNumber      String?
  panNumber         String?
  aadharDocumentUrl String?
  panDocumentUrl    String?
  offerLetterUrl    String?
  otherDocuments    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services     EmployeeService[]
  queueEntries QueueEntry[]
  appointments Appointment[]
  seats        Seat[]
  invoices     Invoice[]
  invoiceLineItems InvoiceLineItem[]
  shifts       Shift[]
  timesheets   Timesheet[]
  faceProfile  EmployeeFaceProfile?
  attendanceRecords AttendanceRecord[]
  staffProductIssues StaffProductIssue[]
  stockLedgerEntries StockLedgerEntry[]
  assignedProjects Project[]
  hairConsultations HairConsultation[]
  loginUser        User?

  @@index([salonId])
  @@index([salonId, status])
  @@index([salonId, name])
}

model EmployeeFaceProfile {
  id               String   @id @default(cuid())
  salonId          String
  salon            Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  employeeId       String   @unique
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  faceDescriptor   String
  enrolledAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt
  enrolledByUserId String?

  @@index([salonId])
}

model AttendanceRecord {
  id                   String    @id @default(cuid())
  salonId              String
  salon                Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date                 DateTime
  checkInAt            DateTime
  checkOutAt           DateTime?
  status               String    @default("WORKING")
  method               String
  confidence           Float?
  totalWorkedMinutes   Int?
  lateMinutes          Int?
  earlyCheckoutMinutes Int?
  notes                String?
  createdByUserId      String?
  correctedByUserId    String?
  correctedAt          DateTime?
  correctionReason     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  auditLogs AttendanceAuditLog[]

  @@unique([employeeId, date])
  @@index([salonId, date])
  @@index([salonId, status, date])
}

model AttendanceAuditLog {
  id                 String           @id @default(cuid())
  salonId            String
  attendanceId       String
  attendance         AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  changedByUserId    String
  action             String
  previousCheckInAt  DateTime?
  previousCheckOutAt DateTime?
  newCheckInAt       DateTime?
  newCheckOutAt      DateTime?
  reason             String?
  createdAt          DateTime         @default(now())

  @@index([salonId, attendanceId])
  @@index([attendanceId])
}

model Shift {
  id         String   @id @default(cuid())
  salonId    String
  salon      Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  startTime  String?
  endTime    String?
  isWorking  Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([salonId, date])
}

model Timesheet {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weekStart   DateTime
  hoursWorked Float    @default(0)
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([salonId, weekStart])
}

model PayRun {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Float    @default(0)
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([salonId, periodStart])
}

model Seat {
  id         String    @id @default(cuid())
  salonId    String
  salon      Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  number     Int
  status     String    @default("available")
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  queueEntries QueueEntry[]
  invoices     Invoice[]

  @@unique([salonId, number])
}

enum ServiceCatalogType {
  SERVICE
  PACKAGE
  ADD_ON
}

enum ServiceAudience {
  MEN
  WOMEN
  UNISEX
  KIDS
  COUPLES
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PackagePricingStrategy {
  STANDARD_TOTAL
  CUSTOM_PRICE
  PERCENTAGE_DISCOUNT
  FIXED_DISCOUNT
}

enum ServiceCategoryGroup {
  SERVICES
  PACKAGES
  ADDONS
}

model ServiceCategory {
  id            String               @id @default(cuid())
  salonId       String
  salon         Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name          String
  sortOrder     Int                  @default(0)
  categoryGroup ServiceCategoryGroup @default(SERVICES)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  services Service[]

  @@index([salonId, categoryGroup, sortOrder])
}

model Service {
  id              String                  @id @default(cuid())
  salonId         String
  salon           Salon                   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  duration        Int
  price           Float
  categoryId      String?
  category        ServiceCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sortOrder       Int                     @default(0)
  catalogType     ServiceCatalogType      @default(SERVICE)
  audience        ServiceAudience         @default(UNISEX)
  status          ServiceStatus           @default(ACTIVE)
  onlineBooking   Boolean                 @default(true)
  inStoreBooking  Boolean                 @default(true)
  isStartingPrice Boolean                 @default(false)
  pricingStrategy PackagePricingStrategy?
  discountPercent Float?
  discountAmount  Float?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  employees            EmployeeService[]
  queueServices        QueueService[]
  appointments         Appointment[]
  invoiceLineItems     InvoiceLineItem[]
  serviceRecipes       ServiceRecipe[]
  hairConsultations    HairConsultation[]
  hairstyles           Hairstyle[]
  packageItems         ServicePackageItem[] @relation("PackageItems")
  includedInPackages   ServicePackageItem[] @relation("IncludedServices")
  parentAddOnLinks     ServiceAddOnLink[]   @relation("ParentService")
  addOnParentLinks     ServiceAddOnLink[]   @relation("AddOnService")

  @@index([salonId, categoryId, sortOrder])
  @@index([salonId, catalogType, status])
  @@index([salonId, audience])
}

model ServiceMenuImport {
  id                String   @id @default(cuid())
  salonId           String
  salon             Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  uploadedById      String
  uploadedBy        User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  filename          String
  fileType          String
  totalRecords      Int
  importedCount     Int
  skippedCount      Int
  failedCount       Int
  warningCount      Int      @default(0)
  categoriesCreated Int      @default(0)
  packagesCreated   Int      @default(0)
  servicesCreated   Int      @default(0)
  servicesReused    Int      @default(0)
  summary           Json?
  createdAt         DateTime @default(now())

  @@index([salonId, createdAt])
}

model ServicePackageItem {
  id                String  @id @default(cuid())
  packageId         String
  package           Service @relation("PackageItems", fields: [packageId], references: [id], onDelete: Cascade)
  includedServiceId String
  includedService   Service @relation("IncludedServices", fields: [includedServiceId], references: [id], onDelete: Restrict)
  sortOrder         Int     @default(0)
  quantity          Int     @default(1)

  @@unique([packageId, includedServiceId])
  @@index([packageId])
  @@index([includedServiceId])
}

model ServiceAddOnLink {
  id              String  @id @default(cuid())
  parentServiceId String
  parentService   Service @relation("ParentService", fields: [parentServiceId], references: [id], onDelete: Cascade)
  addOnServiceId  String
  addOnService    Service @relation("AddOnService", fields: [addOnServiceId], references: [id], onDelete: Cascade)
  sortOrder       Int     @default(0)

  @@unique([parentServiceId, addOnServiceId])
  @@index([parentServiceId])
  @@index([addOnServiceId])
}

model Supplier {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockItems StockItem[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@index([salonId, name])
}

model EmployeeService {
  employeeId String
  serviceId  String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceId])
}

model Customer {
  id        String    @id @default(cuid())
  salonId   String
  salon     Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email          String?
  notes          String?
  birthday       DateTime?
  loyaltyPoints  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  queueEntries QueueEntry[]
  appointments Appointment[]
  invoices     Invoice[]
  stockLedgerEntries StockLedgerEntry[]
  customerMemberships CustomerMembership[]
  membershipTransactions MembershipTransaction[]
  loyaltyPointsLedger LoyaltyPointsLedger[]
  walletAccounts        WalletAccount[]
  familyMembershipMembers FamilyMembershipMember[]
  membershipUsageLogs MembershipUsageLog[]
  hairConsultations   HairConsultation[]

  @@index([salonId, phone])
}

model CustomSegment {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name        String
  description String?
  rules       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([salonId])
}

model QueueEntry {
  id            String       @id @default(cuid())
  salonId       String
  salon         Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  employeeId    String?
  employee      Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  seatId        String?
  seat          Seat?        @relation(fields: [seatId], references: [id], onDelete: SetNull)
  status        String       @default("waiting")
  checkedInAt   DateTime     @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  position      Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  services QueueService[]
  invoices Invoice[]

  @@index([salonId, appointmentId])
}

model QueueService {
  queueEntryId String
  serviceId    String
  queueEntry   QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([queueEntryId, serviceId])
}

model Appointment {
  id          String    @id @default(cuid())
  salonId     String
  salon       Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  scheduledAt DateTime
  status      String    @default("scheduled")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invoices    Invoice[]
  smsReminders SmsReminder[]
  stockLedgerEntries StockLedgerEntry[]
  queueEntries QueueEntry[]

  @@index([salonId, employeeId, scheduledAt])
  @@index([salonId, scheduledAt, status])
}

model Invoice {
  id            String    @id @default(cuid())
  salonId       String
  salon         Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  status        String    @default("draft")
  subtotal      Float
  tax           Float     @default(0)
  total         Float
  amountPaid    Float     @default(0)
  dueDate       DateTime?
  paidAt        DateTime?
  paymentMethod String?
  notes         String?
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  checkInId     String?
  checkIn       QueueEntry?  @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  employeeId    String?
  employee      Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  seatId        String?
  seat          Seat?        @relation(fields: [seatId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lineItems InvoiceLineItem[]

  @@index([salonId, status, paidAt])
  @@index([salonId, employeeId, status, paidAt])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  itemType    String   @default("SERVICE")
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  total       Float
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
}

model StockCategory {
  id        String   @id @default(cuid())
  salonId   String
