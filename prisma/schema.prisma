enum MembershipPlanType {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum MembershipPlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MembershipBenefitType {
  DISCOUNT_PERCENT
  DISCOUNT_FIXED
  FREE_SERVICE
  PRIORITY_BOOKING
  WALLET_BONUS
  LOYALTY_MULTIPLIER
  OTHER
}

enum CustomerMembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
  PENDING
}

enum MembershipTransactionType {
  PURCHASE
  RENEWAL
  UPGRADE
  REFUND
  WALLET_TOPUP
  WALLET_DEBIT
  LOYALTY_EARN
  LOYALTY_REDEEM
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

model MembershipPlan {
  id               String               @id @default(cuid())
  salonId          String
  salon            Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  category         String               @default("Standard")
  type             MembershipPlanType   @default(MONTHLY)
  validityDays     Int                  @default(30)
  price            Float
  tax              Float                @default(0)
  discountPercent  Float                @default(0)
  walletBonus      Float                @default(0)
  rewardMultiplier Float                @default(1)
  priorityBooking  Boolean              @default(false)
  vipAccess        Boolean              @default(false)
  themeColor       String               @default("#22C55E")
  bannerUrl        String?
  badgeUrl         String?
  status           MembershipPlanStatus @default(ACTIVE)
  sortOrder        Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  benefits            PlanBenefit[]
  customerMemberships CustomerMembership[]
  offers              MembershipOffer[]

  @@index([salonId, status])
  @@index([salonId, sortOrder])
}

model MembershipBenefit {
  id          String                @id @default(cuid())
  salonId     String
  salon       Salon                 @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        MembershipBenefitType @default(OTHER)
  value       Float?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  plans PlanBenefit[]

  @@index([salonId])
}

model PlanBenefit {
  planId        String
  benefitId     String
  valueOverride Float?
  plan          MembershipPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  benefit       MembershipBenefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@id([planId, benefitId])
}

model CustomerMembership {
  id               String                   @id @default(cuid())
  salonId          String
  salon            Salon                    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId           String
  plan             MembershipPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  status           CustomerMembershipStatus @default(ACTIVE)
  startDate        DateTime                 @default(now())
  endDate          DateTime
  pricePaid        Float
  taxPaid          Float                    @default(0)
  discountApplied  Float                    @default(0)
  autoRenew        Boolean                  @default(false)
  membershipNumber String
  qrCode           String?
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  transactions  MembershipTransaction[]
  usageLogs     MembershipUsageLog[]
  familyMembers FamilyMembershipMember[]

  @@unique([salonId, membershipNumber])
  @@index([salonId, customerId])
  @@index([salonId, status])
  @@index([salonId, endDate])
}

model MembershipTransaction {
  id                   String                    @id @default(cuid())
  salonId              String
  salon                Salon                     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customerMembershipId String?
  customerMembership   CustomerMembership?       @relation(fields: [customerMembershipId], references: [id], onDelete: SetNull)
  customerId           String
  customer             Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type                 MembershipTransactionType
  amount               Float
  tax                  Float                     @default(0)
  description          String?
  paymentMethod        String?
  invoiceId            String?
  metadata             Json?
  createdAt            DateTime                  @default(now())

  @@index([salonId, customerId])
  @@index([salonId, createdAt])
  @@index([customerMembershipId])
}

model LoyaltySettings {
  id                  String   @id @default(cuid())
  salonId             String   @unique
  salon               Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  pointsPerRupee      Float    @default(1)
  redemptionRate      Float    @default(0.01)
