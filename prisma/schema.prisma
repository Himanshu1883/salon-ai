  customerId      String
  amount          Float
  balanceAfter    Float
  type            String
  description     String?
  referenceId     String?
  createdAt       DateTime      @default(now())

  @@index([salonId, customerId])
  @@index([walletAccountId, createdAt])
}

model MembershipOffer {
  id              String          @id @default(cuid())
  salonId         String
  salon           Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  planId          String?
