  categoryId     String
  category       StockCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId        String?
  brand          ProductBrand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  unit           String   @default("piece")
  quantityOnHand Int      @default(0)
  reorderLevel   Int?
  maxLevel       Int?
  costPrice      Float    @default(0)
  retailPrice    Float    @default(0)
  avgCost        Float    @default(0)
  gstRate        Float    @default(18)
  shelfLocation  String?
  expiryDate     DateTime?
  batchNumber    String?
  imageUrl       String?
  status         String   @default("active")
  isRetail       Boolean  @default(true)
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchases            StockPurchase[]
  purchaseOrderLines   PurchaseOrderLine[]
  grnLineItems         GrnLineItem[]
  stockAdjustments     StockAdjustment[]
  staffProductIssues   StaffProductIssue[]
  serviceRecipes       ServiceRecipe[]
  stockLedgerEntries   StockLedgerEntry[]
  branchTransferLines  BranchTransferLine[]
  invoiceLineItems     InvoiceLineItem[]

