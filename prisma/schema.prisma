enum HairConsultationStatus {
  DRAFT
  PHOTO_CAPTURED
  ANALYZED
  STYLES_TRIED
  STYLE_SELECTED
  COMPLETED
  CANCELLED
}

enum HairConsultationPhotoType {
  ORIGINAL
  PREVIEW
  ACTUAL_RESULT
  THUMBNAIL
}

enum FaceShape {
  OVAL
  ROUND
  SQUARE
  OBLONG
  HEART
  DIAMOND
}

