# PostgreSQL — required (Vercel Postgres, Neon, or local Docker)
# Vercel Postgres auto-injects POSTGRES_URL; set DATABASE_URL to the same value in the dashboard.
DATABASE_URL="postgresql://user:password@localhost:5432/salon_ai?schema=public"

# Direct/non-pooled URL for Prisma migrations (Neon & Vercel Postgres provide this separately)
# DIRECT_DATABASE_URL="postgresql://user:password@host/salon_ai?sslmode=require"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"

# App URL (required in production for NextAuth callbacks)
# Local: http://localhost:3000
# Production: set both to your canonical public URL (must match each other)
#   AUTH_URL="https://www.gotix.io"
#   NEXT_PUBLIC_APP_URL="https://www.gotix.io"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Twilio SMS (optional — without these, SMS runs in demo mode and logs to console)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Transactional email via Resend (optional — without RESEND_API_KEY, reset links log to console in dev)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Glow Desk <noreply@yourdomain.com>"

# OpenAI (optional — without this, AI scheduling uses rule-based suggestions)
OPENAI_API_KEY=""

# Vercel Blob (optional — required for stock bill attachments in production)
# BLOB_READ_WRITE_TOKEN=""
