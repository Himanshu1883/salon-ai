{
  "name": "salon-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:clean": "node scripts/clean-dev-cache.mjs && next dev --webpack",
    "dev:generate": "prisma generate && next dev",
    "build": "prisma generate && npx tsx scripts/migrate-if-postgres.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "test:scope": "npx tsx --test src/lib/permissions/data-scope.test.ts src/lib/appointments/upcoming-today.test.ts src/lib/appointments/check-in-prefill.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:check": "npx tsx scripts/check-db.ts",
    "db:ensure-catalog": "npx tsx scripts/ensure-service-catalog-schema.ts",
    "db:ensure-admin": "npx tsx scripts/ensure-admin.ts",
    "db:seed-basic-customers": "npx tsx scripts/seed-basic-plan-customers.ts",
    "db:seed-makeup-studio": "npx tsx scripts/seed-makeup-studio-services.ts",
    "db:seed-inventory": "npx tsx scripts/seed-inventory-demo.ts",
    "db:link-customers": "npx tsx scripts/link-customers.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:reset-demo-passwords": "npx tsx scripts/reset-demo-passwords.ts",
    "db:backfill-slugs": "npx tsx scripts/backfill-salon-slugs.ts",
    "db:backfill-roles": "npx tsx scripts/backfill-roles.ts",
    "db:backfill-employee-id": "npx tsx scripts/backfill-user-employee-id.ts",
    "db:backfill-employee-id:dry-run": "npx tsx scripts/backfill-user-employee-id.ts --dry-run",
    "db:sync-subscription-plans": "npx tsx scripts/sync-subscription-plans.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@vercel/blob": "^2.8.0",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.16.3",
    "prisma": "^7.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
